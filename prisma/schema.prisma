generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


// Stage: Authentication
// Roles match the staff roles defined in the client requirements doc.
enum Role {
  ADMINISTRATOR
  RECEPTIONIST
  TRIAGE_NURSE
  CLINICIAN
  LAB_STAFF
  PHARMACIST
  BILLING_CASHIER
  NURSING_STAFF
  PROCUREMENT_STAFF
  ACCOUNTS_STAFF
  HR_STAFF
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
